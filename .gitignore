deploy/podman/*.local
# The VPS stack mounts config/ as worldprops; it holds public.conf with the
# database password.
/config/

# Local JDK, tool caches and the RT4 client checkout used by the run scripts
/.toolchain/
/.mavenhome/
/.gradlehome/
/client/

# Rootless podman state for the local container stack: holds image layers and,
# under storage/, the registry auth written by `podman login`.
/.podman/

# Worktrees of this repository, checked out inside it by the run scripts.
/.worktrees/

# Session transcripts dropped here by local tooling.
/.tmp_s_*.jsonl
